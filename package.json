{
  "name": "jupiter-system-v3.2",
  "version": "3.2.4",
  "description": "Discord bot for Call of Cthulhu TRPG",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc && node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "dev": "ts-node src/index.ts",
    "all": "npm run build && npm run start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@discordjs/voice": "^0.19.2",
    "@types/ws": "^8.18.1",
    "axios": "^1.8.4",
    "discord-api-types": "^0.37.67",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "node-cron": "^4.6.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.19",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "^7.5.22"
    }
  }
